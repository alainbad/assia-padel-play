# Supabase project connection. If you're using Lovable Cloud, connecting it
# in the Lovable editor sets these automatically (it also adds
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY without
# the VITE_ prefix for server-side use — see src/integrations/supabase/).
# Otherwise, get these from Project Settings → API in the Supabase dashboard.
#
# The publishable/anon key is safe to expose to the browser — it's what the
# booking form and the admin dashboard both use, with access controlled by
# Row Level Security (see supabase/migrations/0001_bookings_and_admin.sql).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
